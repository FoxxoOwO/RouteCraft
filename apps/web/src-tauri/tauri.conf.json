{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RouteCraft",
  "version": "0.1.0",
  "identifier": "com.foxxo.routecraft",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RouteCraft - Network Simulator & Multi-Vendor Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Discrete-event network simulator and multi-vendor laboratory",
    "longDescription": "RouteCraft is an interactive discrete-event network simulator and multi-vendor lab supporting Cisco IOS, MikroTik RouterOS, and Linux CLI environments.",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 RouteCraft Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["onlab"],
        "name": "RouteCraft Lab Topology",
        "description": "RouteCraft Network Simulation Lab File",
        "role": "Editor"
      }
    ]
  }
}
