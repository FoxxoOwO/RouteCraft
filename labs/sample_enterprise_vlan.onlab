          "name": "Fa0/1",
          "mac_address": "00:aa:bb:cc:dd:01",
          "ipv4_address": null,
          "admin_status": "Up",
          "oper_status": "Up",
          "mtu": 1500,
          "switchport_mode": {
            "Trunk": {
              "native_vlan": 1,
              "allowed_vlans": [10, 20]
