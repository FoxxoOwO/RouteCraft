{
  "version": "1.0.0",
  "title": "Enterprise 802.1Q Inter-VLAN Routing Lab",
  "description": "Cisco Router-on-a-Stick setup with 802.1Q trunking and isolated sales/engineering VLANs",
  "nodes": [
    {
      "id": "r1",
