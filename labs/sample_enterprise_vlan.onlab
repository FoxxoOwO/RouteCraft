          "admin_status": "Up",
          "oper_status": "Up",
          "mtu": 1500,
          "switchport_mode": "Routed",
          "encapsulation_vlan": 20,
          "parent_interface": "Gi0/0",
          "speed_mbps": 1000,
          "duplex": "Full",
          "description": "Default Gateway for VLAN 20 (Engineering)"
        }
      },
      "vlans": {},
